node_modules/
.next/
.env.local
*.log

.vercel
.env*

# Dumped production credentials (deploy exports, env refreshes). These are
# plaintext copies of NK_JWT_SECRET / NK_GIFT_CODE_ENCRYPTION_KEY / DATABASE_URL
# and the repo is PUBLIC — a stray `git add -A` would publish them. `.env*`
# above only covers dotfiles, so name these patterns explicitly.
prod.env
prod.env.*
nk-*.txt
*.env.dump
deploy-env-*.txt

# TypeScript incremental build artifact
tsconfig.tsbuildinfo

# One-off scripts (prod e2e dress rehearsals etc.)
tmp/

# Playwright artifacts
test-results/
playwright-report/
artifacts/

# Browser-smoke build sentinel (written by ci.yml; *.log already covers the
# build log itself)
build-ok.flag

# Git worktrees
.worktrees/
.nk-totp-qr.*

# Data backups (contain customer PII — never commit)
backups/

# Deploy artifacts (deploy-hostatom.sh)
.deploy-stage/
deploy-bundle.tar.gz

# Production health monitor runtime state (scripts/monitor-health.mjs).
# Local scratch state — the scheduled workflow keeps its own copy in the
# Actions cache, and nothing here belongs in git.
.prod-health/
.prod-health-state.json
.prod-health-history.ndjson
.tmp-monitor/
