// Nong-Kati Database Schema
// Source of truth: 06-database.md §7 (Catalogue), §8 (Inventory), §9 (Cart), §10 (Orders)
// Extended by: 10-digital-code.md §2 (Schema Amendments)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  // Migrations (`prisma migrate deploy`, run by the Vercel build) must use the
  // DIRECT connection (db.*.supabase.co:5432), not the pgbouncer pooler on
  // 6543: pgbouncer's transaction pooling breaks DDL/migrations and Vercel's
  // build network cannot reach the pooler at all (consistent P1001 timeouts
  // that killed every production build for a week while the runtime, which
  // uses DATABASE_URL below, connected fine). Runtime queries keep using the
  // pooler; only migrate/db commands switch to the direct URL.
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Categories ───────────────────────────────────────────

model Category {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.LongText
  slug      String   @unique @db.VarChar(191)
  icon      String?  @db.LongText
  parentId  String?  @db.VarChar(191)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

// ─── Products ─────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid()) @db.VarChar(191)
  name             String   @db.LongText
  slug             String   @unique @db.VarChar(191)
  sku              String?  @unique @db.VarChar(191)
  description      String?  @db.LongText
  shortDescription String?  @db.LongText
  imageUrl         String?  @db.LongText
  categoryId       String   @db.VarChar(191)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category          Category            @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  aliases           ProductAlias[]
  inventory         InventorySnapshot[]
  wishlist          WishlistItem[]
  tags              ProductTag[]
  promotionProducts PromotionProduct[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
}

// ─── Product Variants (denominations) ─────────────────────

model ProductVariant {
  id          String   @id @default(cuid()) @db.VarChar(191)
  productId   String   @db.VarChar(191)
  label       String   @db.LongText
  price       Decimal  @db.Decimal(10, 2)
  costThb     Decimal? @db.Decimal(10, 2)
  memberPrice Decimal? @db.Decimal(10, 2)
  dealerPrice Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     InventorySnapshot[]
  stockMoves    StockMove[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  giftCodes     GiftCode[]
  uploadBatches CodeUploadBatch[]

  @@index([productId])
}

// ─── Product Aliases (for search) ─────────────────────────

model ProductAlias {
  id        String   @id @default(cuid()) @db.VarChar(191)
  productId String   @db.VarChar(191)
  alias     String   @db.VarChar(191)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
}

// ─── Inventory Snapshots (for stock tracking) ─────────────

model InventorySnapshot {
  id               String   @id @default(cuid()) @db.VarChar(191)
  productId        String   @db.VarChar(191)
  productVariantId String   @db.VarChar(191)
  previousStock    Int
  newStock         Int
  reason           String   @db.LongText
  createdAt        DateTime @default(now())

  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productId])
  @@index([productVariantId])
}

// ─── Stock Moves (ประวัติการจัดสต๊อกแบบละเอียด — ตัด/เติม/ขาย/คืน) ───

model StockMove {
  id         String   @id @default(cuid()) @db.VarChar(191)
  variantId  String   @db.VarChar(191)
  delta      Int // +เติม / −ตัด / −ขาย / +คืน
  reason     String   @db.VarChar(191) // restock, adjust, sale, refund, import
  refType    String?  @db.LongText // order, upload, manual, csv
  refId      String?  @db.LongText
  note       String?  @db.LongText
  stockAfter Int
  actorType  String   @default("admin") @db.LongText // admin, system
  actorId    String?  @db.LongText
  createdAt  DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([reason])
}

// ─── Carts (§9) ──────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid()) @db.VarChar(191)
  customerId String?  @db.VarChar(191)
  sessionKey String   @unique @db.VarChar(191)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([sessionKey])
  @@index([expiresAt])
}

// ─── Cart Items (§9) ─────────────────────────────────────

model CartItem {
  id           String   @id @default(cuid()) @db.VarChar(191)
  cartId       String   @db.VarChar(191)
  variantId    String   @db.VarChar(191)
  quantity     Int      @default(1)
  unitPriceThb Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─── Customers (08-auth.md §3) ───────────────────────────

model Customer {
  id                  String    @id @default(cuid()) @db.VarChar(191)
  email               String    @unique @db.VarChar(191)
  // Nullable for OAuth-only accounts (Google/LINE/Facebook sign-in has no local password).
  passwordHash        String?   @db.LongText
  fullName            String?   @db.LongText
  phoneNumber         String?   @unique @db.VarChar(191)
  status              String    @default("active") @db.LongText // active | blocked | anonymised
  emailVerified       Boolean   @default(false)
  // Set when the customer proves control of the number via sign-in OTP.
  phoneVerified       Boolean   @default(false)
  marketingOptIn      Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  walletBalanceThb    Decimal   @default(0) @db.Decimal(10, 2)
  // ระดับราคา: retail = ราคาปกติ, member = ราคาสมาชิก, dealer = ราคาตัวแทนจำหน่าย
  tier                String    @default("retail") @db.VarChar(191)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders                Order[]
  wishlist              WishlistItem[]
  topups                TopUpLog[]
  supportTickets        SupportTicket[]
  couponRedemptions     CouponRedemption[]
  notificationReads     NotificationRead[]
  passwordResetTokens   PasswordResetToken[]
  // Customer JWTs issued before this instant stop resolving (password reset
  // revokes stolen/unknown sessions). Login flows always mint fresh tokens
  // with a later iat, so only pre-reset sessions are affected.
  sessionsInvalidBefore DateTime?

  @@index([email])
  // Declared to match the migrated database: Customer_tier_idx exists in the
  // migration history but had no counterpart here, so `migrate dev` would
  // otherwise generate a DROP INDEX against a live index.
  @@index([tier])
}

// ─── Wishlist (client ask: รายการโปรด — สินค้าที่ลูกค้ากดใจไว้) ──

model WishlistItem {
  id         String   @id @default(cuid()) @db.VarChar(191)
  customerId String   @db.VarChar(191)
  productId  String   @db.VarChar(191)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// ─── Wallet top-ups (client ask: ประวัติการเดินเงิน / เครดิตคงเหลือ) ──

model TopUpLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  customerId String   @db.VarChar(191)
  amountThb  Decimal  @db.Decimal(10, 2)
  method     String   @default("promptpay") @db.LongText // promptpay | credit_card | admin_credit
  reference  String?  @db.LongText // payment provider reference / slip id
  status     String   @default("pending") @db.LongText // pending | completed | failed
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

// ─── Promotions (โปรโมชัน — ส่วนลดอัตโนมัติโดยไม่ต้องใส่โค้ด) ──

model Promotion {
  id            String             @id @default(cuid()) @db.VarChar(191)
  name          String             @db.LongText
  description   String?            @db.LongText
  scope         String             @default("selected") @db.LongText // all | selected
  discountType  String             @default("percent") @db.LongText // percent | amount
  discountValue Decimal            @db.Decimal(10, 2)
  // Legacy compatibility column. The expand migration keeps Promotion.productIds
  // so the previously deployed reader keeps working, and the migration's backfill
  // copies each JSON array into PromotionProduct. Nothing in this codebase reads
  // or writes it — it is declared here only so schema.prisma matches the database
  // the migration produces. A later contract migration drops the column and this
  // field together.
  productIds    String?            @db.LongText
  // For 'all' scope, applies to entire shop. For 'selected', these products.
  products      PromotionProduct[]
  minSpendThb   Decimal?           @db.Decimal(10, 2)
  isActive      Boolean            @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive, expiresAt])
  @@index([startsAt, expiresAt])
}

model PromotionProduct {
  id          String @id @default(cuid()) @db.VarChar(191)
  promotionId String @map("promotion_id") @db.VarChar(191)
  productId   String @map("product_id") @db.VarChar(191)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([promotionId, productId])
  @@index([productId])
  @@map("PromotionProduct")
}

// ─── Coupons (คูปองส่วนลด — บาท/%, ยอดขั้นต่ำ, วันหมดอายุ) ──

model Coupon {
  id               String    @id @default(cuid()) @db.VarChar(191)
  code             String    @unique @db.VarChar(191)
  description      String?   @db.LongText
  discountType     String    @default("percent") @db.LongText // percent | amount
  discountValue    Decimal   @db.Decimal(10, 2)
  minSpendThb      Decimal?  @db.Decimal(10, 2)
  usageLimit       Int? // null = ไม่จำกัด
  perCustomerLimit Int?      @default(1)
  usageCount       Int       @default(0)
  isActive         Boolean   @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdBy        String?   @db.LongText
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders            Order[]
  redemptions       CouponRedemption[]
  notificationReads NotificationRead[]

  @@index([isActive])
}

// ─── Coupon redemptions (review M4 — enforce limits atomically) ──
// One row per (coupon, order). The orderId unique constraint makes a
// redemption idempotent per order; per-customer limits count these rows.
model CouponRedemption {
  id         String   @id @default(cuid()) @db.VarChar(191)
  couponId   String   @db.VarChar(191)
  customerId String   @db.VarChar(191)
  orderId    String   @unique @db.VarChar(191)
  createdAt  DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, customerId])
}

// ─── Orders (§10) ────────────────────────────────────────

model Order {
  id                     String    @id @default(cuid()) @db.VarChar(191)
  orderNumber            String    @unique @db.VarChar(191)
  customerId             String?   @db.VarChar(191)
  customerEmail          String    @db.VarChar(191)
  customerPhone          String?   @db.LongText
  status                 String    @default("pending_payment") @db.VarChar(191)
  paymentMethod          String?   @db.LongText
  subtotalThb            Decimal   @db.Decimal(10, 2)
  vatAmountThb           Decimal   @db.Decimal(10, 2)
  discountThb            Decimal   @default(0) @db.Decimal(10, 2)
  totalAmountThb         Decimal   @db.Decimal(10, 2)
  couponId               String?   @db.VarChar(191)
  lineOptIn              Boolean   @default(false)
  marketingOptIn         Boolean   @default(false)
  tosAcceptedAt          DateTime
  tosVersion             String    @default("1.0") @db.LongText
  requiresTaxInvoice     Boolean   @default(false)
  taxInvoiceName         String?   @db.LongText
  taxInvoiceTaxId        String?   @db.LongText
  ipAddress              String?   @db.LongText
  userAgent              String?   @db.LongText
  confirmationUuid       String    @unique @default("") @db.VarChar(191)
  notes                  String?   @db.LongText
  manualFulfilmentReason String?   @db.LongText
  // Aggregate automatic-promotion discount for the order. Per-line promotion
  // evidence (id/name/type/value) lives on OrderItem — the algorithm picks the
  // best promotion per line, so an order-level promotion id/name cannot
  // represent the charged price.
  promotionDiscountThb   Decimal   @default(0) @db.Decimal(10, 2)
  // VAT snapshot (rate in effect at order time, stored as fraction e.g. 0.07)
  vatEnabled             Boolean   @default(false)
  vatRate                Decimal?  @db.Decimal(5, 4)
  // Manual slip check (ลูกค้าส่งสลิปให้แอดมินตรวจ): image path in the
  // SiteSetting image store; admin note recorded on confirmation.
  slipImageUrl           String?   @db.LongText
  slipUploadedAt         DateTime?
  slipAdminNote          String?   @db.LongText
  completedAt            DateTime?
  expiredAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer         Customer?         @relation(fields: [customerId], references: [id])
  couponRedemption CouponRedemption?
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  paymentAttempts  PaymentAttempt[]
  giftCodes        GiftCode[]
  invoices         Invoice[]
  refunds          Refund[]

  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([confirmationUuid])
  @@index([orderNumber])
  // Order_couponId_idx exists in the migrated database but was not declared
  // here; without it `migrate dev` would drop a live index.
  @@index([couponId])
}

// ─── Order Items (§10) ───────────────────────────────────

model OrderItem {
  id                   String    @id @default(cuid()) @db.VarChar(191)
  orderId              String    @db.VarChar(191)
  // Nullable since 2026-10-25 (nullable_catalog_variant_links): a hard
  // product delete detaches historical lines here instead of destroying the
  // order's itemised history. All rendered fields below are snapshots with
  // no catalog FK, so a null variantId still renders and totals correctly.
  variantId            String?   @db.VarChar(191)
  productNameTh        String    @db.LongText
  productNameEn        String    @db.LongText
  skuCode              String    @db.LongText
  denominationThb      Decimal   @db.Decimal(10, 2)
  quantity             Int
  unitPriceThb         Decimal   @db.Decimal(10, 2)
  unitPriceExVat       Decimal   @db.Decimal(10, 2)
  unitVatAmount        Decimal   @db.Decimal(10, 2)
  lineTotalThb         Decimal   @db.Decimal(10, 2)
  deliveryStatus       String    @default("pending") @db.LongText
  deliveredAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Promotion evidence snapshot for this line (historical record — no FK so
  // rows survive promotion edit/delete). unitPriceThb is the effective
  // post-promotion unit price; originalUnitPriceThb is the tier price before
  // any promotion; promotionDiscountThb is the TOTAL discount for the line.
  originalUnitPriceThb Decimal   @default(0) @db.Decimal(10, 2)
  appliedPromotionId   String?   @db.LongText
  promotionName        String?   @db.LongText
  promotionType        String?   @db.LongText // percent | amount
  promotionValue       Decimal?  @db.Decimal(10, 2)
  promotionDiscountThb Decimal   @default(0) @db.Decimal(10, 2)
  // Final line totals after coupon allocation; these persist the exact
  // satang-level values the customer pays per line so item sums reconcile
  // to Order.totalAmountThb and Order.vatAmountThb without rounding drift.
  couponDiscountThb    Decimal   @default(0) @db.Decimal(10, 2)
  finalLineTotalThb    Decimal   @default(0) @db.Decimal(10, 2)
  finalLineExVat       Decimal   @default(0) @db.Decimal(10, 2)
  finalLineVatAmount   Decimal   @default(0) @db.Decimal(10, 2)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  giftCodes GiftCode[]

  @@index([orderId])
  @@index([variantId])
}

// ─── Gift Codes (§8) ─────────────────────────────────────

model GiftCode {
  id            String    @id @default(cuid()) @db.VarChar(191)
  // Nullable since 2026-10-25 (nullable_catalog_variant_links): a code that
  // was already delivered to a customer survives a product purge with
  // variantId nulled — it stays reachable via orderId/orderItemId only.
  variantId     String?   @db.VarChar(191)
  codeEncrypted Bytes
  codeHash      Bytes     @unique @db.VarBinary(32)
  nonce         Bytes
  keyVersion    Int       @default(1)
  status        String    @default("available") @db.VarChar(191)
  orderId       String?   @db.VarChar(191)
  orderItemId   String?   @db.VarChar(191)
  voidedById    String?   @db.LongText
  voidReason    String?   @db.LongText
  uploadedById  String?   @db.LongText
  uploadBatchId String?   @db.VarChar(191)
  reservedAt    DateTime?
  deliveredAt   DateTime?
  voidedAt      DateTime?
  expiresAt     DateTime?
  expiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  uploadBatch CodeUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict)

  @@index([variantId, status])
  @@index([orderId])
  @@index([uploadBatchId])
  @@index([status])
}

// ─── Code Upload Batches (§8) ────────────────────────────

model CodeUploadBatch {
  id               String    @id @default(cuid()) @db.VarChar(191)
  variantId        String    @db.VarChar(191)
  uploadedById     String    @db.LongText
  originalFilename String    @db.LongText
  totalRows        Int       @default(0)
  importedCount    Int       @default(0)
  rejectedCount    Int       @default(0)
  rejectionDetails Json?
  status           String    @default("processing") @db.LongText
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  codes   GiftCode[]

  @@index([variantId])
}

// ─── Payment Attempts (§10) ──────────────────────────────

model PaymentAttempt {
  id                    String    @id @default(cuid()) @db.VarChar(191)
  orderId               String    @db.VarChar(191)
  paymentMethod         String    @db.LongText
  status                String    @default("pending") @db.VarChar(191)
  amountThb             Decimal   @db.Decimal(10, 2)
  gatewayName           String    @db.VarChar(191)
  gatewayRef            String?   @db.VarChar(191)
  gatewayStatusCode     String?   @db.LongText
  gatewayResponse       Json?
  failureReason         String?   @db.LongText
  qrExpiresAt           DateTime?
  threeDsRequired       Boolean   @default(false)
  threeDsStatus         String?   @db.LongText
  webhookReceivedAt     DateTime?
  webhookSignatureValid Boolean?
  // Automatic slip verification (SlipOK): the bank ref is globally unique —
  // one real transfer can confirm exactly one order.
  slipVerifiedRef       String?   @unique @db.VarChar(191)
  slipVerifiedAt        DateTime?
  slipReceiverAccount   String?   @db.LongText
  slipVerifiedBy        String?   @db.LongText
  attemptNumber         Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([gatewayName, gatewayRef])
  @@index([orderId])
  @@index([gatewayName, gatewayRef])
  @@index([status])
}

// ─── Invoices (§12) ──────────────────────────────────────

model Invoice {
  id                  String    @id @default(cuid()) @db.VarChar(191)
  orderId             String    @db.VarChar(191)
  invoiceType         String    @db.LongText
  invoiceNumber       String    @unique @db.VarChar(191)
  pdfStorageKey       String?   @db.LongText
  pdfGeneratedAt      DateTime?
  pdfGenerationFailed Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([invoiceNumber])
}

// ─── Refunds (11-admin.md §14.1) ──────────────────────────

model Refund {
  id                     String   @id @default(cuid()) @db.VarChar(191)
  orderId                String   @db.VarChar(191)
  amountThb              Decimal  @db.Decimal(10, 2)
  reasonCategory         String   @db.VarChar(191)
  reasonDetail           String?  @db.LongText
  gatewayRefundReference String   @db.LongText
  codesVoidedCount       Int      @default(0)
  initiatedBy            String   @db.VarChar(191)
  createdAt              DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([reasonCategory, createdAt(sort: Desc)])
  @@index([initiatedBy])
}

// ─── Site Settings (key/value store for storefront chrome) ──

model SiteSetting {
  id        String   @id @default(cuid()) @db.VarChar(191)
  key       String   @unique @db.VarChar(191)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.LongText

  @@index([key])
}

// ─── Admin Users & Sessions (08-auth.md §4) ────────────────
/// PDPA data-subject requests (access / correction / erasure / portability /
/// objection) — persisted so a submitted request survives restarts and is
/// visible to pdpa:read admins in /management/pdpa.
model DataSubjectRequest {
  id          String    @id @default(cuid()) @db.VarChar(191)
  requestId   String    @unique @db.VarChar(191)
  requestType String    @db.LongText // access | correction | erasure | portability | objection
  fullName    String    @db.LongText
  email       String    @db.VarChar(191)
  phone       String?   @db.LongText
  details     String?   @db.LongText
  status      String    @default("pending") @db.VarChar(191) // pending | in_progress | completed | rejected
  adminNote   String?   @db.LongText
  handledById String?   @db.LongText
  handledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// DB-backed admin auth: scrypt password hashes, per-user lockout,
// TOTP secrets and server-side refresh-token sessions.

model AdminUser {
  id                    String    @id @default(cuid()) @db.VarChar(191)
  email                 String    @unique @db.VarChar(191)
  fullName              String    @db.LongText
  role                  String    @default("super_admin") @db.LongText
  status                String    @default("active") @db.LongText // active | deactivated | locked
  passwordHash          String    @db.LongText // scrypt$N$r$p$salt$hash (lib/password.ts)
  totpSecret            String?   @db.LongText // base32, set during 2FA setup
  totpConfirmed         Boolean   @default(false)
  mustChangePassword    Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  // Separate persistent counter for step-2 TOTP failures (never touched by
  // password failures): 5 strikes locks the account for TOTP_TOTP_LOCKOUT_MS.
  failedTotpAttempts    Int       @default(0)
  totpLockedUntil       DateTime?
  // Sessions issued before this instant are invalid (set by changeAdminPassword
  // so a concurrent refresh cannot mint a post-revocation session).
  sessionsInvalidBefore DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions               AdminSession[]
  supportTicketsAnswered SupportTicket[]
  backupCodes            AdminBackupCode[]

  @@index([email])
}

/// 2FA recovery codes (external audit #9, 2026-09-27): the setup step hands
/// the admin ten one-time codes and stores ONLY their SHA-256 hashes here —
/// the plaintext exists exactly once, in the setup response. Each login may
/// present a code instead of the 6-digit TOTP; the guarded usedAt update is
/// the one-time CAS, and wrong guesses feed the same 5-strike TOTP lockout.
model AdminBackupCode {
  id          String    @id @default(cuid()) @db.VarChar(191)
  adminUserId String    @db.VarChar(191)
  codeHash    String    @unique @db.VarChar(191) // SHA-256 of the normalized plaintext code
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([usedAt])
}

/// One row per consumed login-challenge JWT (sha256 of the token). Step-1
/// challenges are short-lived JWTs; this table is what makes them single-use
/// — confirm2fa records the token here before minting a session, so a
/// replayed challenge can never mint a second session.
model AdminChallengeConsumed {
  id         String   @id @default(cuid()) @db.VarChar(191)
  tokenHash  String   @unique @db.VarChar(191)
  consumedAt DateTime @default(now())

  @@index([consumedAt])
}

model AdminSession {
  id          String    @id @default(cuid()) @db.VarChar(191)
  adminUserId String    @db.VarChar(191)
  tokenHash   String    @unique @db.VarChar(191) // SHA-256 of the opaque refresh token
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
}

// ─── Audit Logs (06-database.md §14, 11-admin.md §14.1) ────

/// Homepage hero carousel slides (admin-managed; images via /api/v1/admin/upload).
model HeroSlide {
  id         String   @id @default(cuid()) @db.VarChar(191)
  /// Image banner; null when the slide is a text deal card (label only).
  imageUrl   String?  @db.LongText
  /// Focal point used when object-cover crops the banner, e.g. "50% 30%".
  /// Null means centred — the historical behaviour, so existing slides are unchanged.
  imageFocus String?  @db.LongText
  /// Promo deal text, e.g. "🔥 HBO Max 7 วัน ฿25" — the ticker's old role.
  label      String?  @db.LongText
  href       String?  @db.LongText
  alt        String   @db.LongText
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  actorType  String   @db.VarChar(191)
  actorId    String   @db.VarChar(191)
  actorEmail String   @db.LongText
  action     String   @db.VarChar(191)
  tableName  String   @db.VarChar(191)
  recordId   String   @db.VarChar(191)
  diffBefore Json?
  diffAfter  Json?
  ipAddress  String?  @db.LongText
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorType, actorId])
  @@index([action])
  @@index([tableName, recordId])
  @@index([createdAt(sort: Desc)])
}

/// Free-form product labels beyond categories (client ask: การจัดการแท็ก).
model Tag {
  id        String       @id @default(cuid()) @db.VarChar(191)
  name      String       @unique @db.VarChar(191)
  slug      String       @unique @db.VarChar(191)
  createdAt DateTime     @default(now())
  products  ProductTag[]
}

model ProductTag {
  productId String  @db.VarChar(191)
  tagId     String  @db.VarChar(191)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ─── Support Tickets (customer → admin correspondence) ───

model SupportTicket {
  id            String    @id @default(cuid()) @db.VarChar(191)
  ticketNumber  String    @unique @db.VarChar(191)
  customerId    String?   @db.VarChar(191)
  customerEmail String    @db.LongText
  customerName  String?   @db.LongText
  subject       String    @db.LongText
  message       String    @db.LongText
  status        String    @default("open") @db.VarChar(191) // open, answered, closed
  adminReply    String?   @db.LongText
  answeredById  String?   @db.VarChar(191)
  answeredAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id])
  answeredBy AdminUser? @relation(fields: [answeredById], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ─── Notifications (storefront bell) ───────────────────────
// There is no Notification row of its own: promo notifications are the
// currently-active coupons, rendered live — nothing to go stale. The only
// stored state is per-customer "read up to" so the unread badge reflects
// reality instead of mock sample data.

model NotificationRead {
  id         String   @id @default(cuid()) @db.VarChar(191)
  customerId String   @db.VarChar(191)
  couponId   String   @db.VarChar(191)
  readAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([customerId, couponId])
  @@index([customerId])
}

// ─── Magic Link sign-in ────────────────────────────────
// Single-use sign-in tokens, stored as SHA-256 hashes (never the raw
// token): a DB leak cannot produce a usable link. attemptedAt records
// consumption attempts for auditing; usedAt marks successful single-use
// consumption. Expired rows are swept opportunistically on request.

model MagicLinkToken {
  id          String    @id @default(cuid()) @db.VarChar(191)
  email       String    @db.VarChar(191)
  tokenHash   String    @unique @db.VarChar(191)
  expiresAt   DateTime
  usedAt      DateTime?
  attemptedAt DateTime?
  ipAddress   String?   @db.LongText
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Password reset: mirrors MagicLinkToken — only the SHA-256 hash of the raw
// token is stored (the emailed value is never persisted), single-use via a
// guarded updateMany, 30-minute expiry, attempt tracking for the audit trail.
model PasswordResetToken {
  id          String    @id @default(cuid()) @db.VarChar(191)
  customerId  String    @db.VarChar(191)
  tokenHash   String    @unique @db.VarChar(191)
  expiresAt   DateTime
  usedAt      DateTime?
  attemptedAt DateTime?
  ipAddress   String?   @db.LongText
  createdAt   DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// Phone (SMS OTP) sign-in: mirrors MagicLinkToken — only the SHA-256 hash of
// the 6-digit code is stored, with expiry, single-use consumption and attempt
// tracking for the audit trail. destinationPhone is E.164 (+66...).
// ─── Email Outbox (external audit #2, 2026-09-27) ─────────
// Durable email queue: enqueueing happens INSIDE the caller's transaction
// (code delivery joins the fulfilment commit — a rolled-back payment can
// never enqueue a delivery email, and a committed payment can never lose
// one). Delivery is claimed atomically (status CAS pending→sending) so
// concurrent workers never double-send; failures back off exponentially
// and the row keeps lastError for the admin outbox view.
model EmailOutbox {
  id             String    @id @default(cuid()) @db.VarChar(191)
  // Idempotency: one row per logical email (e.g. code_delivery:<orderId>).
  // A repeated enqueue attempt inside any later transaction is a no-op
  // (P2002 caught), so retries of confirmations never duplicate mail.
  idempotencyKey String    @unique @db.VarChar(191)
  templateKey    String    @db.VarChar(191) // code_delivery | magic_link | password_reset | order_confirm
  toEmail        String    @db.LongText
  subject        String    @db.LongText
  html           String    @db.LongText
  text           String?   @db.LongText
  status         String    @default("pending") @db.VarChar(191) // pending | sent | failed
  attempts       Int       @default(0)
  lastError      String?   @db.LongText
  availableAt    DateTime  @default(now()) // next eligible delivery attempt
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  // The migrated database carries a DEFAULT on this column; declaring it here
  // keeps schema.prisma and the database in agreement so `migrate dev` does not
  // strip the default out from under non-Prisma inserts.
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([templateKey, createdAt(sort: Desc)])
}

model PhoneOtpToken {
  id               String    @id @default(cuid()) @db.VarChar(191)
  destinationPhone String    @db.VarChar(191)
  codeHash         String    @unique @db.VarChar(191)
  expiresAt        DateTime
  usedAt           DateTime?
  attemptedAt      DateTime?
  attempts         Int       @default(0)
  ipAddress        String?   @db.LongText
  createdAt        DateTime  @default(now())

  @@index([destinationPhone])
  @@index([expiresAt])
}
