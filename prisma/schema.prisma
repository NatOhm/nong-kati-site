// Nong-Kati Database Schema
// Source of truth: 06-database.md §7 (Catalogue), §8 (Inventory), §9 (Cart), §10 (Orders)
// Extended by: 10-digital-code.md §2 (Schema Amendments)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Categories ───────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

// ─── Products ─────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String?  @unique
  description      String?
  shortDescription String?
  imageUrl         String?
  categoryId       String
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category  Category            @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  aliases   ProductAlias[]
  inventory InventorySnapshot[]
  wishlist  WishlistItem[]
  tags      ProductTag[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
}

// ─── Product Variants (denominations) ─────────────────────

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  label       String
  price       Decimal  @db.Decimal(10, 2)
  costThb     Decimal? @db.Decimal(10, 2)
  memberPrice Decimal? @db.Decimal(10, 2)
  dealerPrice Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     InventorySnapshot[]
  stockMoves    StockMove[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  giftCodes     GiftCode[]
  uploadBatches CodeUploadBatch[]

  @@index([productId])
}

// ─── Product Aliases (for search) ─────────────────────────

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  alias     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
}

// ─── Inventory Snapshots (for stock tracking) ─────────────

model InventorySnapshot {
  id               String   @id @default(cuid())
  productId        String
  productVariantId String
  previousStock    Int
  newStock         Int
  reason           String
  createdAt        DateTime @default(now())

  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productId])
  @@index([productVariantId])
}

// ─── Stock Moves (ประวัติการจัดสต๊อกแบบละเอียด — ตัด/เติม/ขาย/คืน) ───

model StockMove {
  id             String   @id @default(cuid())
  variantId      String
  delta          Int // +เติม / −ตัด / −ขาย / +คืน
  reason         String // restock, adjust, sale, refund, import
  refType        String? // order, upload, manual, csv
  refId          String?
  note           String?
  stockAfter     Int
  actorType      String   @default("admin") // admin, system
  actorId        String?
  createdAt      DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([reason])
}

// ─── Carts (§9) ──────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  customerId String?
  sessionKey String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([sessionKey])
  @@index([expiresAt])
}

// ─── Cart Items (§9) ─────────────────────────────────────

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  variantId    String
  quantity     Int      @default(1)
  unitPriceThb Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─── Customers (08-auth.md §3) ───────────────────────────

model Customer {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  fullName            String?
  phoneNumber         String?
  status              String    @default("active") // active | blocked | anonymised
  emailVerified       Boolean   @default(false)
  marketingOptIn      Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  walletBalanceThb    Decimal   @default(0) @db.Decimal(10, 2)
  // ระดับราคา: retail = ราคาปกติ, member = ราคาสมาชิก, dealer = ราคาตัวแทนจำหน่าย
  tier                String    @default("retail")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders         Order[]
  wishlist       WishlistItem[]
  topups         TopUpLog[]
  supportTickets SupportTicket[]

  @@index([email])
}

// ─── Wishlist (client ask: รายการโปรด — สินค้าที่ลูกค้ากดใจไว้) ──

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// ─── Wallet top-ups (client ask: ประวัติการเดินเงิน / เครดิตคงเหลือ) ──

model TopUpLog {
  id         String   @id @default(cuid())
  customerId String
  amountThb  Decimal  @db.Decimal(10, 2)
  method     String   @default("promptpay") // promptpay | credit_card | admin_credit
  reference  String? // payment provider reference / slip id
  status     String   @default("pending") // pending | completed | failed
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

// ─── Coupons (คูปองส่วนลด — บาท/%, ยอดขั้นต่ำ, วันหมดอายุ) ──

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  discountType     String    @default("percent") // percent | amount
  discountValue    Decimal   @db.Decimal(10, 2)
  minSpendThb      Decimal?  @db.Decimal(10, 2)
  usageLimit       Int? // null = ไม่จำกัด
  perCustomerLimit Int?      @default(1)
  usageCount       Int       @default(0)
  isActive         Boolean   @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]

  @@index([isActive])
}

// ─── Orders (§10) ────────────────────────────────────────

model Order {
  id                     String    @id @default(cuid())
  orderNumber            String    @unique
  customerId             String?
  customerEmail          String
  customerPhone          String?
  status                 String    @default("pending_payment")
  paymentMethod          String?
  subtotalThb            Decimal   @db.Decimal(10, 2)
  vatAmountThb           Decimal   @db.Decimal(10, 2)
  discountThb            Decimal   @default(0) @db.Decimal(10, 2)
  totalAmountThb         Decimal   @db.Decimal(10, 2)
  couponId               String?
  lineOptIn              Boolean   @default(false)
  marketingOptIn         Boolean   @default(false)
  tosAcceptedAt          DateTime
  tosVersion             String    @default("1.0")
  requiresTaxInvoice     Boolean   @default(false)
  taxInvoiceName         String?
  taxInvoiceTaxId        String?
  ipAddress              String?
  userAgent              String?
  confirmationUuid       String    @unique @default("")
  notes                  String?
  manualFulfilmentReason String?
  completedAt            DateTime?
  expiredAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id])
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  giftCodes       GiftCode[]
  invoices        Invoice[]
  refunds         Refund[]

  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([confirmationUuid])
  @@index([orderNumber])
}

// ─── Order Items (§10) ───────────────────────────────────

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  variantId       String
  productNameTh   String
  productNameEn   String
  skuCode         String
  denominationThb Decimal   @db.Decimal(10, 2)
  quantity        Int
  unitPriceThb    Decimal   @db.Decimal(10, 2)
  unitPriceExVat  Decimal   @db.Decimal(10, 2)
  unitVatAmount   Decimal   @db.Decimal(10, 2)
  lineTotalThb    Decimal   @db.Decimal(10, 2)
  deliveryStatus  String    @default("pending")
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  giftCodes GiftCode[]

  @@index([orderId])
  @@index([variantId])
}

// ─── Gift Codes (§8) ─────────────────────────────────────

model GiftCode {
  id            String    @id @default(cuid())
  variantId     String
  codeEncrypted Bytes
  codeHash      Bytes     @unique
  nonce         Bytes
  keyVersion    Int       @default(1)
  status        String    @default("available")
  orderId       String?
  orderItemId   String?
  voidedById    String?
  voidReason    String?
  uploadedById  String?
  uploadBatchId String?
  reservedAt    DateTime?
  deliveredAt   DateTime?
  voidedAt      DateTime?
  expiresAt     DateTime?
  expiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  uploadBatch CodeUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict)

  @@index([variantId, status])
  @@index([orderId])
  @@index([uploadBatchId])
  @@index([status])
}

// ─── Code Upload Batches (§8) ────────────────────────────

model CodeUploadBatch {
  id               String    @id @default(cuid())
  variantId        String
  uploadedById     String
  originalFilename String
  totalRows        Int       @default(0)
  importedCount    Int       @default(0)
  rejectedCount    Int       @default(0)
  rejectionDetails Json?
  status           String    @default("processing")
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  codes   GiftCode[]

  @@index([variantId])
}

// ─── Payment Attempts (§10) ──────────────────────────────

model PaymentAttempt {
  id                    String    @id @default(cuid())
  orderId               String
  paymentMethod         String
  status                String    @default("pending")
  amountThb             Decimal   @db.Decimal(10, 2)
  gatewayName           String
  gatewayRef            String?
  gatewayStatusCode     String?
  gatewayResponse       Json?
  failureReason         String?
  qrExpiresAt           DateTime?
  threeDsRequired       Boolean   @default(false)
  threeDsStatus         String?
  webhookReceivedAt     DateTime?
  webhookSignatureValid Boolean?
  attemptNumber         Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([gatewayName, gatewayRef])
  @@index([orderId])
  @@index([gatewayName, gatewayRef])
  @@index([status])
}

// ─── Invoices (§12) ──────────────────────────────────────

model Invoice {
  id                  String    @id @default(cuid())
  orderId             String
  invoiceType         String
  invoiceNumber       String    @unique
  pdfStorageKey       String?
  pdfGeneratedAt      DateTime?
  pdfGenerationFailed Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([invoiceNumber])
}

// ─── Refunds (11-admin.md §14.1) ──────────────────────────

model Refund {
  id                     String   @id @default(cuid())
  orderId                String
  amountThb              Decimal  @db.Decimal(10, 2)
  reasonCategory         String
  reasonDetail           String?
  gatewayRefundReference String
  codesVoidedCount       Int      @default(0)
  initiatedBy            String
  createdAt              DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([reasonCategory, createdAt(sort: Desc)])
  @@index([initiatedBy])
}

// ─── Site Settings (key/value store for storefront chrome) ──

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
}

// ─── Admin Users & Sessions (08-auth.md §4) ────────────────
// DB-backed admin auth: scrypt password hashes, per-user lockout,
// TOTP secrets and server-side refresh-token sessions.

model AdminUser {
  id                    String    @id @default(cuid())
  email                 String    @unique
  fullName              String
  role                  String    @default("super_admin")
  status                String    @default("active") // active | deactivated | locked
  passwordHash          String // scrypt$N$r$p$salt$hash (lib/password.ts)
  totpSecret            String? // base32, set during 2FA setup
  totpConfirmed         Boolean   @default(false)
  mustChangePassword    Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  // Sessions issued before this instant are invalid (set by changeAdminPassword
  // so a concurrent refresh cannot mint a post-revocation session).
  sessionsInvalidBefore DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions            AdminSession[]
  supportTicketsAnswered SupportTicket[]

  @@index([email])
}

/// One row per consumed login-challenge JWT (sha256 of the token). Step-1
/// challenges are short-lived JWTs; this table is what makes them single-use
/// — confirm2fa records the token here before minting a session, so a
/// replayed challenge can never mint a second session.
model AdminChallengeConsumed {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  consumedAt DateTime @default(now())

  @@index([consumedAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique // SHA-256 of the opaque refresh token
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
}

// ─── Audit Logs (06-database.md §14, 11-admin.md §14.1) ────

/// Homepage hero carousel slides (admin-managed; images via /api/v1/admin/upload).
model HeroSlide {
  id        String   @id @default(cuid())
  /// Image banner; null when the slide is a text deal card (label only).
  imageUrl  String?
  /// Promo deal text, e.g. "🔥 HBO Max 7 วัน ฿25" — the ticker's old role.
  label     String?
  href      String?
  alt       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  actorEmail String
  action     String
  tableName  String
  recordId   String
  diffBefore Json?
  diffAfter  Json?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorType, actorId])
  @@index([action])
  @@index([tableName, recordId])
  @@index([createdAt(sort: Desc)])
}

/// Free-form product labels beyond categories (client ask: การจัดการแท็ก).
model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ─── Support Tickets (customer → admin correspondence) ───

model SupportTicket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique
  customerId    String?
  customerEmail String
  customerName  String?
  subject       String
  message       String
  status        String   @default("open") // open, answered, closed
  adminReply    String?
  answeredById  String?
  answeredAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id])
  answeredBy AdminUser? @relation(fields: [answeredById], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}
