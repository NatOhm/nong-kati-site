# ─── Nong-Kati — environment variables ──────────────────
# Copy to .env.local for local development:  cp .env.example .env.local
#
# The local stack is docker-compose.yml (MariaDB 10.11 + Redis + next dev) —
# see docs/local-development.md. Compose supplies DATABASE_URL,
# DATABASE_DIRECT_URL and NK_JWT_SECRET itself, so this file is for a host
# `npm run dev` or a Plesk-style run, not for the container.
#
# Production is Plesk/Passenger on nongkatistore.com — not Vercel/Railway.
# Plain keys live in Plesk → Node.js → Environment; DATABASE_URL and
# DATABASE_DIRECT_URL are write-only **Secrets** on that page (use each row's
# Replace, never the bulk textarea); server.js injects the rest from Infisical
# at boot. See docs/PLESK-CUTOVER.md and docs/secret-rotation-checklist.md.

# ─── Required — the process exits without these ─────────
# REQUIRED_ENV_KEYS in server-bootstrap.js is exactly DATABASE_URL, NK_JWT_SECRET.
DATABASE_URL="mysql://user:<password>@127.0.0.1:3306/nong_kati"
# Only `prisma migrate status|deploy` read this one; keep it on the same database.
DATABASE_DIRECT_URL="mysql://user:<password>@127.0.0.1:3306/nong_kati"
# 32+ characters, or every sign/verify throws JWT_SECRET_TOO_WEAK (src/lib/jwt.ts).
NK_JWT_SECRET=""
# 64 hex chars (32 bytes, aes-256-gcm) — `openssl rand -hex 32`. Gift codes throw
# without it, so uploads and every order that reveals codes fail.
NK_GIFT_CODE_ENCRYPTION_KEY=""
# Absolute origin, no trailing slash. Required in production: customer links
# throw rather than point at localhost (src/lib/siteUrl.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Internal endpoints — every sweep fails closed (503) without it ─
# Sent as the x-cron-token header: order expiry, promotion expiry, email outbox
# drain, slip retention, media sweep.
NK_CRON_SECRET=""
# Machine callers of internal/build-info and internal/ops-health.
NK_INTERNAL_TOKEN=""

# ─── Payments — the live checkout is manual transfer + slip ─
NK_SLIP2GO_SECRET=""   # slip auto-verify; issued by the provider (IP-allowlisted)
NK_SLIP_OK_KEY=""      # SlipOk, the alternative provider
NK_SLIP_OK_BRANCH=""
# NK_SLIP2GO_BASE=""            # unset = https://connect.slip2go.com
# SLIP_VERIFY_BASE_OVERRIDE=""   # points slip checks at a local stub; unset in production
# NK_PAYMENT_MOCK=""             # "true" only in dev — ignored when NODE_ENV=production
# NK_OMISE_SECRET_KEY=""         # card gateway, not the live path
# NK_OMISE_WEBHOOK_SECRET=""

# ─── Email (Resend) — half-configured means no mail, never a fake "sent" ─
NK_RESEND_API_KEY=""
NK_RESEND_FROM_EMAIL=""  # the exact From header, e.g. "Nong-Kati <noreply@…>"

# ─── Customer sign-in — each provider is skipped while its keys are unset ─
NK_GOOGLE_CLIENT_ID=""
NK_GOOGLE_CLIENT_SECRET=""
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
NK_FB_APP_ID=""
NK_FB_APP_SECRET=""
NK_TWILIO_ACCOUNT_SID=""  # SMS OTP
NK_TWILIO_AUTH_TOKEN=""
NK_TWILIO_FROM_NUMBER=""
NK_OTP_DEV_MODE=""        # "1" logs OTP codes instead of sending SMS (dev only)

# ─── Rate limiting (Upstash REST) ───────────────────────
# The compose `redis:` service is NOT this one — nothing reads a redis:// URL, so
# unset means the in-process limiter. Set these only where limits must be
# shared across workers.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# NK_RATE_LIMIT_STRICT=""   # "true" = fail closed when there is no shared limiter

# ─── Alerts, CSP, storage ───────────────────────────────
# NK_DISCORD_WEBHOOK_URL=""  # order / low-stock alerts; server env only
NK_CSP_REPORT_ONLY="true"    # "false" enforces the CSP
# NK_CSP_UNSAFE_INLINE=""    # escape hatch, never in production
NK_MEDIA_DIR=""              # uploads on disk; unset = <cwd>/storage/media
# NK_SLIP_DIR=""             # unset = <NK_MEDIA_DIR>/private/slips (not web-served)
# NK_SLIP_TOKEN_SECRET=""    # falls back to NK_JWT_SECRET

# ─── Gift-code key rotation only — unset in normal operation ─
# NK_GIFT_CODE_ENCRYPTION_KEY_V2=""    # the retiring key, while rows re-encrypt
# NK_GIFT_CODE_ACTIVE_KEY_VERSION="2"  # stamp new codes with v2 mid-rotation

# ─── Production only: Infisical machine identity ────────
# Plesk holds ONLY these; server.js pulls every other secret at boot. Local dev
# does not need them, and the values never belong in git.
INFISICAL_CLIENT_ID=""
INFISICAL_CLIENT_SECRET=""
INFISICAL_PROJECT_ID=""
INFISICAL_ENV="prod"
INFISICAL_SITE_URL="https://app.infisical.com"
